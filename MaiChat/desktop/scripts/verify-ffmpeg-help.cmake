# Runs inside the normal desktop CTest runtime gate. Keep the two native streams
# separate: exit0 alone cannot prove that the embedded help callback was cleared.
if(NOT DEFINED HELP_EXECUTABLE OR NOT EXISTS "${HELP_EXECUTABLE}")
  message(FATAL_ERROR "HELP_EXECUTABLE must name the built embedded FFmpeg test")
endif()
if(NOT DEFINED HELP_EVIDENCE_DIRECTORY)
  message(FATAL_ERROR "HELP_EVIDENCE_DIRECTORY must name an owned test output directory")
endif()
file(MAKE_DIRECTORY "${HELP_EVIDENCE_DIRECTORY}")
set(help_stdout "${HELP_EVIDENCE_DIRECTORY}/stdout.log")
set(help_stderr "${HELP_EVIDENCE_DIRECTORY}/stderr.log")
execute_process(COMMAND "${HELP_EXECUTABLE}" --help-output-smoke
  RESULT_VARIABLE help_exit
  OUTPUT_FILE "${help_stdout}" ERROR_FILE "${help_stderr}" TIMEOUT 60)
if(NOT help_exit STREQUAL "0")
  message(FATAL_ERROR "Embedded help test exited ${help_exit}; see ${HELP_EVIDENCE_DIRECTORY}")
endif()
file(READ "${help_stdout}" help_output)
file(READ "${help_stderr}" help_error)
string(REPLACE "\r\n" "\n" help_output "${help_output}")
set(expected_stdout "OWNED_STDOUT_AFTER_CLEAR\nOWNED_UNRELATED_STDOUT\nOwned embedded FFmpeg help: 0 failures\n")
if(NOT help_output STREQUAL expected_stdout)
  message(FATAL_ERROR "Help or unexpected output leaked to stdout; see ${help_stdout}")
endif()
foreach(marker OWNED_AVLOG_STDERR_AFTER_HELP OWNED_AVLOG_STDERR_AT_END)
  string(FIND "${help_error}" "${marker}" marker_at)
  if(marker_at LESS 0)
    message(FATAL_ERROR "Restored log callback marker missing from stderr: ${marker}")
  endif()
endforeach()
message(STATUS "Embedded FFmpeg help and independent stdout/stderr markers verified")
