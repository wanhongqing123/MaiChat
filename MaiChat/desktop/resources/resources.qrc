<RCC>
  <qresource prefix="/maichat">
    <file alias="app-icon.png">macos/AppIcon-1024.png</file>
  </qresource>
  <!-- 正文字体维持 Inter + Noto Sans SC；代码使用三端共用的 Sarasa Fixed SC，
       ASCII/线框为一格、CJK 为两格。各字体均为 SIL OFL 1.1。 -->
  <qresource prefix="/maichat/fonts">
    <file alias="Inter-latin-400.ttf">fonts/Inter-latin-400.ttf</file>
    <file alias="Inter-latin-500.ttf">fonts/Inter-latin-500.ttf</file>
    <file alias="Inter-latin-600.ttf">fonts/Inter-latin-600.ttf</file>
    <file alias="Inter-latin-700.ttf">fonts/Inter-latin-700.ttf</file>
    <file alias="NotoSansSC-Regular.otf">../../Presentation/fonts/NotoSansSC-Regular.otf</file>
    <file alias="NotoSansSC-Medium.otf">../../Presentation/fonts/NotoSansSC-Medium.otf</file>
    <file alias="NotoSansSC-Bold.otf">../../Presentation/fonts/NotoSansSC-Bold.otf</file>
    <file alias="NotoSerifSC-Regular.otf">../../Presentation/fonts/NotoSerifSC-Regular.otf</file>
    <file alias="NotoSerifSC-Medium.otf">../../Presentation/fonts/NotoSerifSC-Medium.otf</file>
    <file alias="NotoSerifSC-SemiBold.otf">../../Presentation/fonts/NotoSerifSC-SemiBold.otf</file>
    <file alias="NotoSerifSC-Bold.otf">../../Presentation/fonts/NotoSerifSC-Bold.otf</file>
    <file alias="LICENSE-NotoSansSC.txt">../../Presentation/fonts/LICENSE-NotoSansSC.txt</file>
    <file alias="LICENSE-NotoSerifSC.txt">../../Presentation/fonts/LICENSE-NotoSerifSC.txt</file>
    <file alias="JetBrainsMono-latin-400.ttf">fonts/JetBrainsMono-latin-400.ttf</file>
    <file alias="JetBrainsMono-latin-700.ttf">fonts/JetBrainsMono-latin-700.ttf</file>
    <file alias="SarasaFixedSC-Regular.ttf">../../Resources/fonts/SarasaFixedSC-Regular.ttf</file>
    <file alias="LICENSE-SarasaFixedSC.txt">../../Resources/fonts/LICENSE-SarasaFixedSC.txt</file>
  </qresource>
  <qresource prefix="/maichat/avatars">
    <file alias="chibi-atlas-v3.png">avatars/chibi-atlas-v3.png</file>
  </qresource>
  <qresource prefix="/maichat/models">
    <file alias="face_detection_yunet_2023mar.onnx">../../MobileAgentAdapter/models/face_detection_yunet_2023mar.onnx</file>
    <file alias="human_segmentation_pphumanseg_2023mar.onnx">../../MobileAgentAdapter/models/human_segmentation_pphumanseg_2023mar.onnx</file>
  </qresource>
  <!-- Tabler Icons v3.x (MIT) plus MaiChat's creative-studio and player icons. -->
  <qresource prefix="/maichat/icons">
    <file alias="message-circle.svg">icons/tabler/message-circle.svg</file>
    <file alias="creative-studio.svg">icons/creative-studio.svg</file>
    <file alias="users.svg">icons/tabler/users.svg</file>
    <file alias="device-desktop.svg">icons/tabler/device-desktop.svg</file>
    <file alias="settings.svg">icons/tabler/settings.svg</file>
    <file alias="message-circle-filled.svg">icons/tabler/message-circle-filled.svg</file>
    <file alias="creative-studio-filled.svg">icons/creative-studio-filled.svg</file>
    <file alias="users-filled.svg">icons/tabler/users-filled.svg</file>
    <file alias="device-desktop-filled.svg">icons/tabler/device-desktop-filled.svg</file>
    <file alias="settings-filled.svg">icons/tabler/settings-filled.svg</file>
    <file alias="arrow-up.svg">icons/tabler/arrow-up.svg</file>
    <file alias="terminal-2.svg">icons/tabler/terminal-2.svg</file>
    <file alias="ai-sparkles.svg">icons/ai-sparkles.svg</file>
    <file alias="player-play.svg">icons/player-play.svg</file>
    <file alias="player-pause.svg">icons/player-pause.svg</file>
    <file alias="player-next.svg">icons/player-next.svg</file>
    <file alias="player-fullscreen.svg">icons/player-fullscreen.svg</file>
    <file alias="user-circle.svg">icons/tabler/user-circle.svg</file>
    <file alias="tabler-license.txt">icons/tabler/LICENSE.txt</file>
  </qresource>
</RCC>
