# Define this zone in the nginx `http` context, not inside `server`:
# limit_req_zone $binary_remote_addr zone=maichat_cloud_drive:10m rate=20r/s;

# Place this more specific location in the TLS server block before /api/v1/.
# Multipart video bytes go directly to OSS; this route carries only small JSON.
location ^~ /api/v1/cloud-drive/ {
    limit_req zone=maichat_cloud_drive burst=100 nodelay;
    limit_req_status 429;
    client_max_body_size 4k;
    access_log off;
    proxy_pass http://127.0.0.1:9100/v1/cloud-drive/;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Authorization $http_authorization;
    proxy_read_timeout 180s;
    add_header Cache-Control "no-store" always;
}

location ^~ /api/v1/ {
    # Startup loads profile, friends and credentials concurrently. Keep the shared
    # steady rate below, but allow one normal startup without rejecting its tail.
    limit_req zone=maichat_auth burst=60 nodelay;
    limit_req_status 429;
    error_page 429 = @maichat_api_rate_limited;
    client_max_body_size 4k;
    access_log off;
    proxy_pass http://127.0.0.1:9100/v1/;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Authorization $http_authorization;
    proxy_read_timeout 20s;
    add_header Cache-Control "no-store" always;
}

# Only locally rejected requests enter here. Upstream business 429 responses keep
# their original body because proxy_intercept_errors remains off.
location @maichat_api_rate_limited {
    internal;
    default_type application/json;
    add_header Retry-After 1 always;
    add_header Cache-Control "no-store" always;
    return 429 '{"error":"Too many requests","code":"RATE_LIMITED"}';
}

# Define in the http context:
# limit_req_zone $binary_remote_addr zone=maichat_auth:10m rate=60r/m;
